          <ButtonText>Feature Explorer</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidFeatureExplorerCmdSet" id="RenameFolderCommandId" priority="0x0100" type="Button">
        <Parent guid="guidFeatureExplorerCmdSet" id="FolderContextMenuGroup" />

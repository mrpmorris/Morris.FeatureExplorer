              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidFeatureExplorerPackage">
    <Menus>
      <Menu guid="guidFeatureExplorerCmdSet" id="FolderContextMenu" priority="0x0000" type="Context">
        <Strings>
          <ButtonText>Folder Context</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidFeatureExplorerCmdSet" id="FeatureExplorerMenuGroup" priority="0x0350">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW" />
      </Group>
      <Group guid="guidFeatureExplorerCmdSet" id="FolderContextMenuGroup" priority="0x0100">
        <Parent guid="guidFeatureExplorerCmdSet" id="FolderContextMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidFeatureExplorerCmdSet" id="FeatureExplorerCommandId" priority="0x0100" type="Button">

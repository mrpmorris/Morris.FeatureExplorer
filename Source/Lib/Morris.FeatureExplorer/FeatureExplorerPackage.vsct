          <ButtonText>Rename</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidFeatureExplorerPackage" value="{99D4D800-6E98-4CCE-A79E-6289362828EA}" />

    <GuidSymbol name="guidFeatureExplorerCmdSet" value="{A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D}">
      <IDSymbol name="FeatureExplorerMenuGroup" value="0x1020" />
      <IDSymbol name="FolderContextMenu" value="0x1030" />

<UserControl x:Class="Morris.FeatureExplorer.FeatureExplorerToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Morris.FeatureExplorer.Models">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:FileNode}">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
    </UserControl.Resources>
    <TreeView ItemsSource="{Binding RootNodes}"

              BorderThickness="0" />
</UserControl>

<UserControl x:Class="Morris.FeatureExplorer.FeatureExplorerToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:Morris.FeatureExplorer"
             xmlns:models="clr-namespace:Morris.FeatureExplorer.Models"
             Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
    <UserControl.Resources>
        <local:FileIconConverter x:Key="FileIconConverter" />
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <imaging:CrispImage x:Name="FolderIcon" Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.FolderClosed}" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                    <Setter TargetName="FolderIcon" Property="Moniker" Value="{x:Static catalog:KnownMonikers.FolderOpened}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:FileNode}">
            <StackPanel Orientation="Horizontal">
                <imaging:CrispImage Width="16" Height="16" Moniker="{Binding Name, Converter={StaticResource FileIconConverter}}" Margin="0,0,4,0" />
                <TextBlock x:Name="DisplayText" Text="{Binding Name}" Visibility="Visible" />
                <TextBox x:Name="EditText" Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                         Visibility="Collapsed"
                         MinWidth="100"
                         LostFocus="OnRenameTextBoxLostFocus"
                         KeyDown="OnRenameTextBoxKeyDown"
                         IsVisibleChanged="OnRenameTextBoxIsVisibleChanged" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <TreeView ItemsSource="{Binding RootNodes}"
              SelectedItemChanged="OnSelectedItemChanged"
              PreviewMouseRightButtonUp="OnTreeViewRightClick"
              Background="Transparent"
              BorderThickness="0" />
</UserControl>

<UserControl x:Class="Morris.FeatureExplorer.Features.FeatureExplorer.FeatureExplorerToolWindowControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:local="clr-namespace:Morris.FeatureExplorer.Features.FeatureExplorer"
						 xmlns:models="clr-namespace:Morris.FeatureExplorer.Features.FeatureExplorer.Models">
	<UserControl.Resources>
		<local:NodeToIconConverter x:Key="NodeToIconConverter" />
		<HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding ChildNodes}">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="{Binding Converter={StaticResource NodeToIconConverter}}" Margin="0,0,4,0" />
				<TextBlock Text="{Binding Name}" />
			</StackPanel>
		</HierarchicalDataTemplate>
		<DataTemplate DataType="{x:Type models:FileNode}">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="{Binding Converter={StaticResource NodeToIconConverter}}" Margin="0,0,4,0" />
				<TextBlock Text="{Binding Name}" />
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>
	<TreeView ItemsSource="{Binding RootNodes}" BorderThickness="0">
		<TreeView.ItemContainerStyle>
			<Style TargetType="TreeViewItem">
				<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
			</Style>
		</TreeView.ItemContainerStyle>
	</TreeView>
</UserControl>
